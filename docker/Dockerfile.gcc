# Task 2: build, test and run the project with GCC.
FROM ubuntu:24.04 AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends g++ cmake make \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY CMakeLists.txt adaptive_allocator.hpp test_adaptive_allocator.cpp benchmark.cpp ./
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++ \
 && cmake --build build -j"$(nproc)" \
 && ctest --test-dir build --output-on-failure

FROM ubuntu:24.04
COPY --from=build /src/build/adaptive_tests /src/build/adaptive_benchmark /app/
COPY docker/entrypoint.sh /app/entrypoint.sh
ENV COMPILER=gcc
WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]
